{
    "name": "kinglive/backend",
    "description": "King Live - Premium Livestreaming Platform",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "aws/aws-sdk-php": "^3.0",
        "cyberdeep/laravel-agora-token-generator": "^1.0",
        "intervention/image": "^3.7",
        "laravel/framework": "^11.0",
        "laravel/horizon": "^5.24",
        "laravel/octane": "^2.0",
        "laravel/reverb": "^1.10",
        "laravel/sanctum": "^4.0",
        "laravel/telescope": "^5.0",
        "league/flysystem-aws-s3-v3": "^3.32",
        "predis/predis": "^2.2",
        "spatie/laravel-activitylog": "^4.7",
        "spatie/laravel-permission": "^6.0",
        "tymon/jwt-auth": "^2.1",
        "yasserbelhimer/agora-access-token-generator": "^1.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/tinker": "^2.9",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-install-cmd": [
            "@php artisan key:generate --ansi --no-interaction",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
